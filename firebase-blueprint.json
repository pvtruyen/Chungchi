{
  "entities": {
    "CertificateRecord": {
      "title": "CertificateRecord",
      "description": "Bản ghi chứng chỉ Giáo dục Quốc phòng và An ninh theo từng sinh viên",
      "type": "object",
      "properties": {
        "stt": { "type": "string", "description": "Số thứ tự lưu phôi bằng" },
        "soHieuChungChi": { "type": "string", "description": "Số văn bằng in trên phôi" },
        "soVaoSoGoc": { "type": "string", "description": "Số vào sổ gốc cấp chứng chỉ" },
        "tenChungChi": { "type": "string", "description": "Tên loại chứng chỉ" },
        "hoVaTen": { "type": "string", "description": "Họ và tên người học" },
        "mssv": { "type": "string", "description": "Mã số sinh viên (Khóa chính)" },
        "ngaySinh": { "type": "string", "description": "Ngày tháng năm sinh" },
        "noiSinh": { "type": "string", "description": "Nơi sinh" },
        "gioiTinh": { "type": "string", "description": "Giới tính (Nam/Nữ)" },
        "danToc": { "type": "string", "description": "Dân tộc" },
        "khoaHoc": { "type": "string", "description": "Khóa đào tạo" },
        "nganhDaoTao": { "type": "string", "description": "Ngành đào tạo" },
        "xepLoai": { "type": "string", "description": "Xếp loại kết quả học tập" },
        "ngayCap": { "type": "string", "description": "Ngày cấp chứng chỉ" },
        "donViCap": { "type": "string", "description": "Đơn vị cấp phát" },
        "fileName": { "type": "string", "description": "Tên file Excel nguồn" }
      },
      "required": ["stt", "mssv", "hoVaTen", "ngayCap"]
    },
    "SyncMeta": {
      "title": "SyncMeta",
      "description": "Siêu dữ liệu thống kê trạng thái đồng bộ",
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "totalRecords": { "type": "number" },
        "lastUpdated": { "type": "string" },
        "fileCount": { "type": "number" },
        "fileNames": { "type": "array" }
      }
    },
    "SearchHistoryRecord": {
      "title": "SearchHistoryRecord",
      "description": "Lịch sử sinh viên tra cứu chứng chỉ phục vụ cán bộ cấp phát theo dõi",
      "type": "object",
      "properties": {
        "mssv": { "type": "string" },
        "hoVaTen": { "type": "string" },
        "stt": { "type": "string" },
        "ngayCap": { "type": "string" },
        "soHieuChungChi": { "type": "string" },
        "soVaoSoGoc": { "type": "string" },
        "tenChungChi": { "type": "string" },
        "donViCap": { "type": "string" },
        "timestamp": { "type": "string" },
        "timeFormatted": { "type": "string" },
        "daPhat": { "type": "boolean" },
        "status": { "type": "string" }
      },
      "required": ["mssv", "timestamp"]
    }
  },
  "firestore": {
    "/gdqp_certificates/{mssv}": {
      "schema": "CertificateRecord",
      "description": "Danh bạ chứng chỉ tra cứu theo MSSV"
    },
    "/gdqp_meta/{metaId}": {
      "schema": "SyncMeta",
      "description": "Trạng thái cấu hình nguồn dữ liệu đám mây"
    },
    "/gdqp_search_history/{historyId}": {
      "schema": "SearchHistoryRecord",
      "description": "Lịch sử tra cứu cấp phát chứng chỉ"
    }
  }
}
